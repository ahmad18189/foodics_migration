				params = parse_qs(parsed.query)
				if "page" in params:
					total_pages = int(params["page"][0])
			except:
				pass
		
		if total_pages is None and meta.get("pagination"):
			pagination = meta["pagination"]
			if "total_pages" in pagination:
				total_pages = int(pagination["total_pages"])
		
		if total_pages:
			sync_log.db_set("total_pages", total_pages)
			sync_log.add_log_entry(f"Total pages from API: {total_pages}", None, None, "INFO")
		
		# Update current_page as we process
		sync_log.db_set("current_page", 1)
		
		# Paginate through fully paid orders
		page_num = 1
		(cfg, s, date_filters=date_filters, only_fully_paid=True):
			try:
				
				# Get business_date for this order
				order_business_date = order_json.get("business_date")
				if order_business_date:
					current_business_date = order_business_date
					
					# Check if business_date changed
					if previous_business_date is not None and current_business_date != previous_business_date:
						# Business date changed - create invoices for previous date
						if orders_for_current_date:
							sync_log.add_log_entry(
								f"Business date changed from {previous_business_date} to {current_business_date}. Creating invoices for {previous_business_date}...",
								None, None, "INFO"
							)
							
							# Create invoices for previous business_date
							prev_date_results = create_sales_invoices_from_orders(
								from_date=previous_business_date,
								to_date=previous_business_date,
								date_field="business_date",
								only_without_invoice=True,
							)
							
							invoices_created += prev_date_results.get("created", 0)
							invoices_skipped += prev_date_results.get("skipped", 0)
							
							sync_log.add_log_entry(
								f"Created {prev_date_results.get('created', 0)} invoices for {previous_business_date}",
								None, None, "INFO"
							)
							
							# Update last_business_date
							sync_log.db_set("last_business_date", previous_business_date)
