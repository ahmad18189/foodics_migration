                    url = None
                    break
        
        if url:  # Only process if we didn't break above
        
        # Stop processing if business_date exceeds to_date
        if date_filters and date_filters.get("to_date"):
            to_date = date_filters["to_date"]
        for row in rows:
                order_business_date = row.get("business_date")
                if order_business_date and order_business_date > to_date:
                    print(f"[info] Stopping: order business_date {order_business_date} exceeds to_date {to_date}")
                    url = None
                    break
        
            to_date = date_filters["to_date"]
            for row in rows:
                order_business_date = row.get("business_date")
                if order_business_date and order_business_date > to_date:
